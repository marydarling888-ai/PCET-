{
  "id": "pcet-app",
  "name": "PCET - Patient Cost Estimator Tool",
  "short_name": "PCET",
  "description": "Store insurance plans, track deductibles, and compare out-of-pocket costs. Works fully offline, all data stays on your device.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0A0A12",
  "theme_color": "#0A0A12",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["health", "finance", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": { "client_mode": "focus-existing" },
  "handle_links": "preferred",
  "edge_side_panel": { "preferred_width": 480 },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshots/desktop-home.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Plans screen on desktop"
    },
    {
      "src": "screenshots/mobile-home.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Plans screen on mobile"
    }
  ],
  "shortcuts": [
    { "name": "Compare plans", "short_name": "Compare", "url": "./index.html?page=compare", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Track deductibles", "short_name": "Track", "url": "./index.html?page=track", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Log spending", "short_name": "Spending", "url": "./index.html?page=log", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
